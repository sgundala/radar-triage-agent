# ── Copy this file to .env and fill in your key ──────────────────────────
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
# .env is git-ignored. Never commit a real key.

# DEFAULT · OpenRouter (cloud). Get a key at openrouter.ai -> Keys.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# ── Optional: run on a local model via Ollama instead of OpenRouter ──
# No key, no credits, no network. Needs Ollama installed and a tool-calling
# model pulled (ollama pull qwen2.5:7b). Uncomment to switch.
# See block5_inference.py for how the switch works.
# USE_LOCAL_LLM=1
# LOCAL_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
